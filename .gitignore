# ==============================================================================
# SpeakFlow V2 — Master .gitignore
# Compatible with Next.js (Frontend) + FastAPI/Python (Backend) + AI/Audio Stack
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets (NEVER COMMIT API KEYS)
# ------------------------------------------------------------------------------
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
credentials.json
secrets/

# ------------------------------------------------------------------------------
# 2. Node.js & Next.js Frontend
# ------------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# Next.js build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Frontend debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. Python & FastAPI Backend
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 4. Audio, Media & Model Cache Files (Large Files / User Data)
# ------------------------------------------------------------------------------
# Recorded temporary voice clips & samples
*.webm
*.m4a
*.wav
*.mp3
*.ogg
*.flac
backend/temp_*.*
backend/test_audio/test_recording.*
test_recording.*

# ML Model Weight Caches (Faster-Whisper / HuggingFace)
models/
.cache/
huggingface/
faster-whisper/

# Local databases
*.db
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.sqlite3

# Explicitly keep dictionary/calibration JSON data files
!backend/data/phoneme_dictionary.json
!backend/data/manual_overrides.json

# ------------------------------------------------------------------------------
# 5. Playwright & E2E Testing Artifacts
# ------------------------------------------------------------------------------
.playwright-mcp/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ------------------------------------------------------------------------------
# 6. Operating System & Editor Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# IDE & Editors
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ------------------------------------------------------------------------------
# 7. SpeakFlow local additions (huge binaries & local-only artifacts)
# ------------------------------------------------------------------------------
# Vendored ffmpeg builds are ~240MB each — install ffmpeg instead
*.exe
*.mp4
*.crdownload
Audios/
.db_backup/
.agent/
test_suite.db
_backend.log

# ------------------------------------------------------------------------------
# 8. Local working docs & reference folders (never commit)
# ------------------------------------------------------------------------------
/HANDOFF.md
/readme-craftsman/
/github/
/story-mode/
/Logo.png

# ------------------------------------------------------------------------------
# 9. bin/ — retired files kept out of the repository
# ------------------------------------------------------------------------------
/bin/

# Flick animation workspaces (build artifacts + node_modules)
/flick-output/
