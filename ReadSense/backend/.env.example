# ── SpeakFlow environment template — copy to .env and fill in ──────────────
# Google AI Studio keys (comma-separated for rate-limit rotation).
# Powers BOTH the Gen-1 Gemma pipeline and the v2 Gemini feedback layer.
GOOGLE_API_KEYS=key1,key2,key3

# Dedicated demo-day key (used when ENV=demo so dev traffic never eats quota)
GEMINI_API_KEY_DEMO=
ENV=dev

# Groq (online STT, roadmap Phase B)
GROQ_API_KEY=

# Optional: cloud sync ingest endpoint for offline sessions (roadmap Phase H)
CLOUD_SYNC_URL=

# Optional tuning (defaults in core/config.py)
# WHISPER_MODEL=tiny
# STT_TIMEOUT_S=3
# WORD_CORRECT_THRESHOLD=70
# CHECKPOINT_PASS_THRESHOLD=70

# ── Reading AI engine selection (Settings → live-editable, teacher only) ──────
# STT_MODE: auto = Groq when online + key, local Whisper otherwise
#           groq = prefer Groq cloud (graceful local fallback when offline)
#           local = never call Groq
STT_MODE=auto
# GEN1_AGENT_MODEL (classic-engine diagnosis agents):
#           auto = Gemini 3.5 Flash-Lite (fast, recommended)
#           gemini-3.5-flash-lite | gemma-4-31b-it
GEN1_AGENT_MODEL=auto
